# ─── API 연결 ───────────────────────────────────────────────────
# API 기본 경로. Vite 프록시 사용 시 /api 유지
VITE_API_BASE_URL=/api

# Vite 개발 서버 프록시 대상 (백엔드 서버 주소)
VITE_BACKEND_TARGET=http://localhost:8080

# ─── Mock 전환 스위치 ─────────────────────────────────────────────
# true: 모든 API가 __mocks__/ 데이터를 반환 (백엔드 없이 UI 확인)
# false: 실제 백엔드 호출 (VITE_API_BASE_URL 사용)
VITE_USE_MOCK=true
