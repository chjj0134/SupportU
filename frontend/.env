# ─── API 연결 ───────────────────────────────────────────────────
# API 기본 경로. Vite 프록시 사용 시 /api 유지
VITE_API_BASE_URL=/api

# Vite 개발 서버 프록시 대상 (백엔드 서버 주소)
VITE_BACKEND_TARGET=http://localhost:8080

# ─── Mock 전환 스위치 ─────────────────────────────────────────────
# true: 정책/체크리스트 mock 데이터 사용 (백엔드 없이 UI 확인)
# false: 실제 /api/policies, /api/checklist 호출
VITE_USE_MOCK_DATA=false

# true: Google OAuth 없이 mock 유저로 로그인 (개발·테스트용)
# false: 실제 /oauth2/authorization/google 흐름 사용
VITE_MOCK_AUTH=false
